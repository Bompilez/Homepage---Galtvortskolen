---
import Layout from '../layouts/Layout.astro';
import { getContent, safeLink } from '../lib/content';
const { settings } = await getContent();
const studioUrl = import.meta.env.PUBLIC_SANITY_STUDIO_URL;
---

<Layout settings={settings} title="Redaktørinnlogging">
  <section class="container admin-page">
    <h1>
      Her redigerer
      <br />
      du magien.
    </h1>
    {studioUrl ? (
      <>
        <p>Logg inn i Sanity for å oppdatere tekster, bilder og arrangementer.</p>
        <a class="button button-gold" href={safeLink(studioUrl)}>
          Åpne redaktørverktøyet →
        </a>
      </>
    ) : (
      <>
        <p>
          Redaktørverktøyet er klargjort, men venter på tilkobling til Galtvortskolens
          Sanity-prosjekt.
        </p>
        <p>Når prosjektet er koblet til, finner du innloggingen her.</p>
      </>
    )}
    <a class="text-link" href="/">
      Tilbake til nettsiden →
    </a>
  </section>
</Layout>
