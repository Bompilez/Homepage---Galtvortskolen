---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getContent, registrationIsOpen, dateLabel, money } from '../../lib/content';
const { settings, events } = await getContent();
const today = new Date().toISOString().slice(0, 10);
const upcoming = events.filter((event) => event.endDate >= today);
const past = events.filter((event) => event.endDate < today);
---

<Layout settings={settings} title="Arrangementer">
  <section class="page-heading container">
    <h1>
      Her begynner
      <br />
      ditt neste eventyr.
    </h1>
    <p class="lead">Finn frem kappen og fantasien. Vi tar oss av magien.</p>
  </section>
  <section class="container event-list">
    <h2>Kommende arrangementer</h2>
    {upcoming.length === 0 && (
      <p>Nye eventyr er under planlegging. Følg med her for neste arrangement.</p>
    )}
    {upcoming.map((event) => (
      <article class="featured-event">
        <a class="event-image" href={`/arrangementer/${event.slug}/`}>
          <img src={event.image.url} alt={event.image.alt} width="1200" height="607" />
          <span class="image-tag">
            {registrationIsOpen(event) ? 'Påmelding åpen' : 'Påmelding stengt'}
          </span>
        </a>
        <div class="event-copy">
          <h3>{event.title}</h3>
          <p>{event.summary}</p>
          <div class="event-meta">
            <span>
              {dateLabel(event.startDate)} – {dateLabel(event.endDate)}
            </span>
            <span>
              {event.location} · {event.age}
            </span>
          </div>
          <div class="event-action">
            <a class="button button-gold" href={`/arrangementer/${event.slug}/`}>
              Se arrangementet <Icon />
            </a>
            <span>{money(event.price)}</span>
          </div>
        </div>
      </article>
    ))}
  </section>
  {past.length > 0 && (
    <section class="container past-events">
      <h2>Tidligere arrangementer</h2>
      {past.map((event) => (
        <a class="text-link" href={`/arrangementer/${event.slug}/`}>
          {event.title}
          <Icon />
        </a>
      ))}
    </section>
  )}
</Layout>
