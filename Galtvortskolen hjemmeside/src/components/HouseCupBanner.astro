---
import { cupQuery, houses, standings, leaderLabel, type Cup } from '../lib/house-cup';

const projectId = import.meta.env.SANITY_PROJECT_ID;
const dataset = import.meta.env.SANITY_DATASET || 'production';
const endpoint = projectId
  ? `https://${projectId}.api.sanity.io/v2026-01-01/data/query/${dataset}?${new URLSearchParams({ query: cupQuery, perspective: 'published' })}`
  : '';
let cup: Cup | null = null;
try {
  if (endpoint) {
    const response = await fetch(endpoint, { signal: AbortSignal.timeout(5000) });
    if (response.ok) cup = (await response.json()).result ?? null;
  }
} catch {
  // Hidden until the browser can fetch fresh cup data.
}
const preview = import.meta.env.DEV && !cup;
const rows = preview
  ? houses.map((house, index) => ({ ...house, points: [240, 185, 160, 125][index] }))
  : standings(cup);
const hasPoints = rows.some((row) => row.points !== 0);
const sortedRows = rows.slice().sort((a, b) => b.points - a.points);
const leader = hasPoints ? sortedRows[0] : rows[0];
const bannerLabel = preview ? 'Smygard leder huscupen' : leaderLabel(cup);
const bannerPoints = hasPoints ? leader.points.toLocaleString('nb-NO') : '0';
---

{(endpoint || preview) && (
  <a
    class:list={['cup-live-banner', (cup || preview) && 'is-visible', preview && 'is-preview']}
    href="/huspokalen/"
    data-cup-banner
    data-cup-endpoint={endpoint}
    style={`--leader-color: ${leader.color}`}
    aria-label="Se stillingen i kampen om huspokalen"
  >
    <strong data-banner-leader>{bannerLabel}</strong>
    <span class="cup-live-points">
      <b data-banner-points>{bannerPoints}</b>
      <span>poeng</span>
    </span>
  </a>
)}

<script src="../scripts/HouseCupBanner.ts"></script>
