---
import {
  cupQuery,
  standings,
  leaderLabel,
  recentEntries,
  signedPoints,
  entryDate,
  houses,
  type Cup,
} from '../lib/house-cup';
import '../styles/house-cup.css';

interface Props {
  variant?: 'full' | 'teaser' | 'page';
}

const { variant = 'full' } = Astro.props;
const isTeaser = variant === 'teaser';
const isPage = variant === 'page';
const projectId = import.meta.env.SANITY_PROJECT_ID;
const dataset = import.meta.env.SANITY_DATASET || 'production';
const endpoint = projectId
  ? `https://${projectId}.api.sanity.io/v2026-01-01/data/query/${dataset}?${new URLSearchParams({ query: cupQuery, perspective: 'published' })}`
  : '';
let cup: Cup | null = null;
try {
  if (endpoint) {
    const response = await fetch(endpoint, { signal: AbortSignal.timeout(5000) });
    if (response.ok) cup = (await response.json()).result ?? null;
  }
} catch {
  // The browser retries if Sanity is temporarily unavailable during the build.
}
const rows = standings(cup);
const maximum = Math.max(1, ...rows.map((row) => row.points));
function floatingCupCards(cup: Cup | null) {
  const entries = recentEntries(cup);
  if (entries.length > 0) {
    return Array.from({ length: Math.min(12, Math.max(8, entries.length)) }, (_, index) => {
      const entry = entries[index % entries.length];
      const house = houses.find((item) => item.key === entry.house) ?? houses[0];
      return {
        house: house.name,
        color: house.color,
        points: signedPoints(entry.points),
        text: entry.reason,
      };
    });
  }

  return Array.from({ length: 12 }, (_, index) => {
    const row = rows[index % rows.length];
    return {
      house: row.name,
      color: row.color,
      points: `${row.points.toLocaleString('nb-NO')}`,
      text: row.points ? 'Huset holder stand i kampen.' : 'Klart for nye poeng.',
    };
  });
}
const floatingCards = floatingCupCards(cup);
---

<section
  class:list={['house-cup container', isTeaser && 'house-cup-teaser', isPage && 'house-cup-page']}
  aria-labelledby="house-cup-title"
  data-cup-endpoint={endpoint}
  style={isPage ? `--leader-color: ${rows[0].color}` : undefined}
>
  {!isPage && (
    <div class="cup-floating-cards" aria-hidden="true" data-cup-floating-cards>
      {floatingCards.map((card, index) => (
        <span
          class="cup-floating-card"
          style={`--event-house-color: ${card.color}; --float-index: ${index}`}
        >
          <b>{card.points}</b>
          <small>{card.house}</small>
          <em>{card.text}</em>
        </span>
      ))}
    </div>
  )}
  {!isPage && (
    <div class="cup-intro">
      <h2 id="house-cup-title">Kampen om huspokalen</h2>
      <p>
        Samarbeid, kunnskap og gode gjerninger. Hvert poeng teller når husene kjemper om seieren.
      </p>
      {isTeaser ? (
        <a class="button button-outline cup-cta" href="/huspokalen/">
          Se hele stillingen
        </a>
      ) : (
        <p class="cup-season-note">
          Poengene følger husene gjennom sommer- og vinterleiren. Etter vinterleiren starter en ny
          sesong.
        </p>
      )}
    </div>
  )}
  <div class="cup-board" data-cup-glint={isPage ? true : undefined}>
    <div class="cup-board-heading">
      <h3 id={isPage ? 'house-cup-title' : undefined} data-cup-season>
        {cup?.title ?? 'Huscupen'}
      </h3>
      <span class="cup-refresh-label">Oppdateres automatisk</span>
    </div>
    <p class="cup-leader" data-cup-leader>
      {leaderLabel(cup)}
    </p>
    <ol class="cup-rows" aria-label="Husenes poengstilling">
      {rows.map((row) => (
        <li
          data-house={row.key}
          data-leading={
            rows.some((item) => item.points !== 0) && row.points === rows[0].points
              ? 'true'
              : 'false'
          }
          style={`--house-color: ${row.color}`}
        >
          <span class="cup-sparkles" aria-hidden="true">
            {Array.from({ length: 6 }, (_, i) => (
              <span style={`--spark: ${i}`}>*</span>
            ))}
          </span>
          <div class="cup-row-heading">
            <span>{row.name}</span>
            <strong data-cup-points>
              {row.points.toLocaleString('nb-NO')} <span>poeng</span>
            </strong>
          </div>
          <div class="cup-track" aria-hidden="true">
            <span
              data-cup-bar
              style={`width: ${(Math.max(0, row.points) / maximum) * 100}%`}
            ></span>
          </div>
        </li>
      ))}
    </ol>
    <p class="cup-status" data-cup-status role="status">
      {cup ? 'Henter siste poengstilling ...' : 'Ingen poeng er publisert ennå.'}
    </p>
    <noscript>
      <p class="cup-status">
        Slå på JavaScript for å få oppdaterte poeng uten å laste siden på nytt.
      </p>
    </noscript>
  </div>
  {!isTeaser && (
    <div class="cup-history">
      <div class="cup-history-heading">
        <h3>Siste poenghendelser</h3>
        <p>Hvem, hva og hvorfor - de åtte siste hendelsene denne sesongen.</p>
      </div>
      <p data-cup-empty hidden={recentEntries(cup).length > 0}>
        Ingen poenghendelser er registrert ennå.
      </p>
      <ol class="cup-events" data-cup-events aria-label="Siste tildelinger og poengtrekk">
        {recentEntries(cup).map((entry) => (
          <li
            class="cup-event"
            style={`--event-house-color: ${houses.find((house) => house.key === entry.house)?.color}`}
            data-kind={entry.points > 0 ? 'award' : 'deduction'}
          >
            <strong class="cup-event-points">
              {signedPoints(entry.points)}
              <span>poeng</span>
            </strong>
            <div class="cup-event-copy">
              <h4>{entry.recipient}</h4>
              <p class="cup-event-meta">
                {houses.find((house) => house.key === entry.house)?.name} ·{' '}
                {entryDate(entry.occurredAt)}
              </p>
              <p class="cup-event-reason">{entry.reason}</p>
              {entry.awardedBy && <p class="cup-event-by">Gitt av {entry.awardedBy}</p>}
            </div>
          </li>
        ))}
      </ol>
      <template data-cup-event-template>
        <li class="cup-event">
          <strong class="cup-event-points">
            <b data-event-points></b>
            <span>poeng</span>
          </strong>
          <div class="cup-event-copy">
            <h4 data-event-recipient></h4>
            <p class="cup-event-meta" data-event-meta></p>
            <p class="cup-event-reason" data-event-reason></p>
            <p class="cup-event-by" data-event-by hidden></p>
          </div>
        </li>
      </template>
    </div>
  )}
</section>

<script src="../scripts/HouseCup.ts"></script>
