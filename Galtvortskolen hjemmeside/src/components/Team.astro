---
import Icon from './Icon.astro';
import type { TeamContent } from '../lib/content';
import '../styles/team.css';

interface Props {
  team: TeamContent;
}
const { team } = Astro.props;
---

<section id="team" class="team-section" aria-labelledby="team-heading">
  <h2 id="team-heading">{team.title}</h2>
  <p class="team-intro">{team.intro}</p>

  <div class="team-grid">
    {team.members.map((member, index) => (
      <article class="team-card">
        {member.photos[0] && (
          <img
            class="team-portrait"
            src={member.photos[0].url}
            alt={member.photos[0].alt}
            width="600"
            height="800"
            loading="lazy"
          />
        )}
        <div class="team-card-copy">
          <p class="team-character">{member.character}</p>
          <h3>{member.name}</h3>
          {member.responsibility && <p class="team-responsibility">{member.responsibility}</p>}
          {member.subject && <p class="team-subject">Fag: {member.subject}</p>}
          <button
            type="button"
            class="text-link team-read-more"
            data-team-template={`team-member-${index}`}
            aria-haspopup="dialog"
            aria-controls="team-dialog"
            aria-label={`Les mer om ${member.name}`}
          >
            Les mer <Icon />
          </button>
        </div>
        <template id={`team-member-${index}`}>
          <div class="team-dialog-grid">
            <div class="team-gallery">
              {member.photos[0] && (
                <img
                  class="team-dialog-portrait"
                  src={member.photos[0].url}
                  alt={member.photos[0].alt}
                  width="600"
                  height="800"
                />
              )}
              {member.photos.length > 1 && (
                <div class="team-thumbnails" role="group" aria-label={`Bilder av ${member.name}`}>
                  {member.photos.map((photo, photoIndex) => (
                    <button
                      type="button"
                      class="team-thumbnail"
                      data-photo-src={photo.url}
                      data-photo-alt={photo.alt}
                      aria-label={`Vis bilde ${photoIndex + 1} av ${member.name}`}
                      aria-pressed={photoIndex === 0 ? 'true' : 'false'}
                    >
                      <img src={photo.url} alt="" width="90" height="110" />
                    </button>
                  ))}
                </div>
              )}
            </div>
            <div class="team-biography">
              <h2 id="team-dialog-title">{member.name}</h2>
              <p class="team-character">{member.character}</p>
              {member.responsibility && (
                <p class="team-dialog-responsibility">{member.responsibility}</p>
              )}
              {member.subject && <p class="team-dialog-subject">Fag: {member.subject}</p>}
              {member.bio.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </div>
        </template>
      </article>
    ))}
  </div>
</section>

<dialog id="team-dialog" class="team-dialog" aria-labelledby="team-dialog-title">
  <div class="team-dialog-toolbar">
    <button type="button" class="team-close" autofocus>
      Lukk <span aria-hidden="true">×</span>
    </button>
  </div>
  <div class="team-dialog-content"></div>
</dialog>

<script src="../scripts/Team.ts"></script>
