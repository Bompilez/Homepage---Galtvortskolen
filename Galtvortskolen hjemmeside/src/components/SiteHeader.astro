---
import Icon from './Icon.astro';
import { safeLink, type SiteContent } from '../lib/content';

interface Props {
  settings: SiteContent['settings'];
}
const { settings } = Astro.props;
const menuGroups = [
  {
    title: 'Opplev magien',
    links: [
      {
        label: 'Opplevelsen',
        description: 'Skoletimer, rollespill og fellesskap',
        href: '/opplevelsen/',
      },
      { label: 'Huspokalen', description: 'Følg kampen mellom husene', href: '/huspokalen/' },
    ],
  },
  {
    title: 'Planlegg besøket',
    links: [
      { label: 'Arrangementer', description: 'Datoer, pris og påmelding', href: '/arrangementer/' },
      {
        label: 'Praktisk info',
        description: 'Dette er lurt å vite før leiren',
        href: '/praktisk-info/',
      },
      {
        label: 'For foresatte',
        description: 'Trygghet og rammer rundt oppholdet',
        href: '/praktisk-info/#foresatte',
      },
    ],
  },
  {
    title: 'Om oss',
    links: [
      { label: 'Menneskene bak', description: 'Bli kjent med Galtvortskolen', href: '/om-oss/' },
      { label: 'Kontakt', description: 'Spørsmål eller forespørsler?', href: '/kontakt/' },
    ],
  },
];
---

{settings.announcement && (
  <a class="announcement" href={safeLink(settings.announcementUrl)}>
    <Icon name="star" />
    <span>{settings.announcement}</span>
    <Icon />
  </a>
)}
<header class="site-header">
  <a class="brand" href="/" aria-label={`${settings.siteName} – forsiden`}>
    <span class="brand-mark" aria-hidden="true">
      G<span>✦</span>
    </span>
    <span class="brand-type">
      {settings.siteName}
      <small>Magiske arrangementer siden 2008</small>
    </span>
  </a>
  <button class="menu-toggle" type="button" aria-controls="site-menu" aria-expanded="false">
    <span class="menu-lines" aria-hidden="true"></span>
    <span>Meny</span>
  </button>
  <a class="button button-gold header-events" href="/arrangementer/">
    Arrangementer <Icon />
  </a>
  <nav id="site-menu" class="site-menu" aria-label="Hovedmeny" hidden>
    <div class="mega-menu-panel">
      <div class="mega-menu-intro">
        <span>Finn frem</span>
        <strong>Hvor vil du begynne?</strong>
        <p>Alt om opplevelsen, oppholdet og menneskene bak magien.</p>
      </div>
      {menuGroups.map((group) => (
        <div class="mega-menu-column">
          <h2>{group.title}</h2>
          {group.links.map((link) => (
            <a
              href={link.href}
              aria-current={Astro.url.pathname === link.href ? 'page' : undefined}
            >
              <strong>{link.label}</strong>
              <span>{link.description}</span>
            </a>
          ))}
        </div>
      ))}
      <a class="mega-menu-booking" href="/arrangementer/">
        Finn arrangementer <Icon />
      </a>
    </div>
    <div class="mobile-nav-content">
      {menuGroups.map((group) => (
        <div class="mobile-nav-section">
          <p>{group.title}</p>
          {group.links.map((link) => (
            <a href={link.href}>
              {link.label}
              <Icon />
            </a>
          ))}
        </div>
      ))}
      <a href="/arrangementer/">
        Finn arrangementer <Icon />
      </a>
    </div>
  </nav>
</header>

<script src="../scripts/SiteHeader.ts"></script>
