---
import '../styles/magic.css';
---

<div class="site-magic">
  <canvas class="magic-canvas" aria-hidden="true"></canvas>
  <p class="magic-message" role="status" aria-live="polite" aria-atomic="true"></p>
  <button
    class="magic-toggle"
    type="button"
    aria-label="Lumos – tenn magien"
    aria-pressed="false"
    hidden
  >
    <span class="magic-star" aria-hidden="true">
      ✧
    </span>
    <span data-magic-label>Litt magi?</span>
  </button>
</div>

<script src="../scripts/Magic.ts"></script>
